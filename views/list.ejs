<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Completed Books List</title>
  <link rel="stylesheet" href="/style.css" />
  <script src="/script.js" defer></script>
</head>
<body>
  <!-- Navbar -->
  <nav class="navbar">
    <div class="navbar-logo">
      <img
        src="https://images.squarespace-cdn.com/content/v1/5b328976aa49a1b7b46b89c3/1530039440176-O24B7OCR4WPIAI62JZTW/CompSci.High_Circle_Logo.png?format=750w"
        alt="School Logo"
      />
    </div>
    <ul class="nav-links">
      <li><a href="/">Reading Tracker</a></li>
    </ul>
  </nav>

  <div class="container">
    <h1>Completed Books List</h1>
    <section class="book-list-section">
      <div class="card-grid">
        <% for (let i = 0; i < books.length; i++) { %>
          <div class="card">
            <img src="<%= books[i].image %>" alt="Book Cover" />
            <div class="card-content">
            <h2><%= books[i].title %></h2>
            <p>Author: <%= books[i].author %></p>
            <p>Student: <%= books[i].student %></p>
            <p>Pages: <%= books[i].pagesRead %>/<%= books[i].totalPages %></p>
            <p>Started: <%= books[i].startDate.toDateString() %></p> 
              <% if (books[i].completed) { %>
               <p>Completed ✅</p>
               <% } else { %>
               <p>Not completed ❌</p>
               <% } %>
              
           <form onsubmit="editBook(event, '<%= books[i]._id %>')">
                <input name="pagesRead" type="number" min="0" max="<%= books[i].totalPages %>" placeholder="New pages read" required />
              <label>
               <% if (books[i].completed) { %>
                <input type="checkbox" name="completed" checked />
                <% } else { %>
                <input type="checkbox" name="completed" />
               <% } %>
                 Mark as completed
                 </label>
  <div class="button-row">
         <button type="submit">Update</button>
         <button type="button" onclick="deleteBook('<%= books[i]._id %>')">Delete</button>
         </div>
       </form>
         </div>
          </div>
        <% } %>
      </div>
    </section>
  </div>
</body>
</html>

